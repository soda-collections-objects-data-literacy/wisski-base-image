# General settings
MODE=production
SERVICE_NAME=wisski-base-stack
USER_GROUPS=
# Image version; mirrors the wisski_base manifest version in the
# drupal_packages repo (module and recipe versions are baked into the image).
WISSKI_BASE_IMAGE_VERSION=latest

# Database settings
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=drupal
DB_PASSWORD=change_me
DB_PORT=3306
DB_USER=drupal

# Drupal settings
DRUPAL_DOMAIN=localhost
DRUPAL_LOCALE=en
DRUPAL_PASSWORD=also_change_me
# Reverse proxy (only needed behind Traefik or similar TLS-terminating edge):
#   (unset)|none  - no reverse proxy settings (default; use for dockerWissKI / local dev)
#   auto          - detect Docker network CIDRs from container interfaces
#   or pipe-separated CIDRs, e.g. 172.20.0.0/16|192.168.64.0/20
# DRUPAL_PROXY_ADDRESSES=
# Private files live outside the web root and persist in a volume.
DRUPAL_PRIVATE_FILES_DIR=/opt/drupal/private-files
DRUPAL_SITE_NAME=My WissKI
# Seperated by | for multiple addresses
DRUPAL_TRUSTED_HOSTS='^localhost$|^127\.0\.0\.1$'
DRUPAL_USER=admin

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379

# WissKI settings
# Recipe versions are baked into the image (see drupal_packages wisski_base
# manifest); the *_VERSION variables only act as flags: non-empty = apply
# the recipe on first install.
WISSKI_DEFAULT_GRAPH=http://my.graph/contents/
WISSKI_STARTER_VERSION=true
WISSKI_DEFAULT_DATA_MODEL_VERSION=true
WISSKI_FLAVOURS=
# After recipes: replace contrib/wisski with a shallow git checkout (dev only).
# WISSKI_8X_4X_DEVELOPMENT=1
# WISSKI_8X_4X_BRANCH=8.x-4.x

# Triplestore settings
TS_PASSWORD=ts_password
TS_READ_URL=http://public.graph.database/repositories/default
TS_REPOSITORY=default
TS_TOKEN=
TS_USERNAME=ts_user
TS_WRITE_URL=http://public.graph.database/repositories/default/statements

# Keycloak settings
OPENID_CONNECT_CLIENT_SECRET=
KEYCLOAK_ADMIN_GROUP=
KEYCLOAK_REALM=
KEYCLOAK_USER_GROUP=

# Nextcloud settings
# external (sidecar mount, recommended in SCS) | sync (standalone rclone) | none
NEXTCLOUD_MOUNT_MODE=none
# Only for NEXTCLOUD_MOUNT_MODE=sync (ignored in external mode):
#NEXTCLOUD_BASE_URL=
#NEXTCLOUD_LOGIN_NAME=
#NEXTCLOUD_APP_PASSWORD=
